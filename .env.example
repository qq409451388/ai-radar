# Optional environment overrides for CI / containers.
# Desktop use should configure AI Radar through the first-run page, which writes
# a user-level config.yaml. This project does NOT automatically load .env.

# ===== LLM (OpenAI-compatible) =====
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=your-glm-api-key
LLM_MODEL=glm-4-plus
LLM_TIMEOUT_SECONDS=120

# ===== GitHub (Releases & private memory repo) =====
GITHUB_TOKEN=

# ===== Private memory repository =====
PROFILE_GITHUB_REPO=owner/private-memory
PROFILE_GITHUB_REF=main
PROFILE_GITHUB_PATH_PREFIX=
PROFILE_GITHUB_TOKEN=

# ===== Application =====
# SQLite database file location (relative to project root or absolute)
AI_RADAR_DB_PATH=data/ai_radar.db
# Timezone used for scheduling and display
AI_RADAR_TIMEZONE=Asia/Shanghai
# Disable scheduler if needed (true/false)
AI_RADAR_SCHEDULER_ENABLED=true
# Request timeout for external HTTP requests (seconds)
AI_RADAR_HTTP_TIMEOUT=20
# Maximum source items analyzed in one run (controls latency and Token use)
AI_RADAR_ANALYZE_BATCH_SIZE=30
# Independent AI requests within one pipeline stage (1-8)
AI_RADAR_AI_CONCURRENCY=4
# Current-follow-up score only considers changes in this recent window
AI_RADAR_SCORE_WINDOW_DAYS=90
# Maximum personal facts sent to one coverage assessment
AI_RADAR_MAX_ASSESSMENT_FACTS=24
